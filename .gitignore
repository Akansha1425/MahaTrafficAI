*.faiss
*.pkl

# ML Models and checkpoints
ml/models/*
!ml/models/.gitkeep
*.joblib
*.onnx

# Big Data temporary & warehouse outputs
metastore_db/
derby.log
spark-warehouse/
warehouse/
.spark-staging/
hdfs-data/

# Logs & Reliability run traces
reliability/logs/*
!reliability/logs/.gitkeep
*.log

# Node & Frontend dependencies and build outputs
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
