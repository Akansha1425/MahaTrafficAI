# ==============================================================================
# MahaTraffic AI — Environment Configuration Template
# Copy this file to .env and populate with your local values.
# WARNING: NEVER commit your actual .env file or hard-code production secrets!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="MahaTraffic AI"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# OpenRouter / LLM Configuration
# Required for Planner, Reviewer, and Specialized Agents (Phase 11-12)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# MongoDB Database Configuration
# Used for storing run logs, reliability metrics, and processed analytical aggregates
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mahatraffic_ai

# Embeddings & RAG Configuration
# Used by Knowledge/RAG Agent for official road safety manuals & MoRTH guidelines
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=rag/index/road_safety_faiss.index
DOCUMENTS_PATH=rag/documents

# MCP (Model Context Protocol) Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_ALLOWED_TOOLS=get_city_accident_statistics,get_monthly_accident_statistics,get_yearly_accident_statistics,calculate_risk_score,predict_risk,analyze_sentiment,get_social_trends,search_road_safety_documents

# Big Data & Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=MahaTrafficAI-SparkAnalytics
PARQUET_DATA_PATH=data/processed/parquet

# Machine Learning Models
ML_MODEL_PATH=ml/models/random_forest_risk.joblib

# Reliability & Execution Tracing
RELIABILITY_LOGS_PATH=reliability/logs
EXECUTION_TIMEOUT_SECONDS=60
MAX_TOOL_RETRIES=2
